# Copy to .env (gitignored) and fill in. build_from_scratch.sh sources this file.
# Values already set in your shell environment take precedence over this file.

# --- OIDC (required for login) ---
# Rotate this secret in your identity provider — the previous value was committed
# to git history and must be considered compromised.
HOMELAB_OIDC_CLIENT_SECRET=

# --- Break-glass (emergency, non-OIDC admin login) ---
# Your OIDC provider is hosted on this homelab, so if it's down you'd be locked
# out of the UI that would fix it. Break-glass is a ONE-TIME way back in: the
# token lives in a file (not here), and a successful login deletes it so it can't
# be reused. The /auth/break-glass route 404s until the file is armed. Arm it
# (portable — works in dev and prod; prints the token as it writes it):
#   docker exec homelab sh -c 'od -An -N24 -tx1 /dev/urandom | tr -d " \n" \
#     | tee /run/secrets/breakglass_token; chmod 600 /run/secrets/breakglass_token'
# On the prod release image you can instead run:
#   docker exec homelab bin/homelab rpc 'IO.puts(Homelab.Auth.BreakGlass.arm!())'
# Override the file location (defaults into the homelab-iab-secrets volume) or the
# admin label only:
# HOMELAB_BREAKGLASS_TOKEN_FILE=/run/secrets/breakglass_token
# HOMELAB_BREAKGLASS_USER=breakglass

# --- TLS / ACME (DNS-01, Cloudflare) ---
# Traefik requests the wildcard *.HOMELAB_BASE_DOMAIN cert over DNS-01, and is not
# provisioned at all without a credential — no token means no ingress. Needs
# Zone:Read + Zone:DNS:Edit.
#
# Optional HERE: if unset, the app falls back to the `acme_dns_api_token` and then
# the `cloudflare_api_token` you set in Settings -> DNS & Domains, so configuring
# Cloudflare in the UI is enough. This env var wins over both, which is how you
# supply the token as a Docker/Swarm secret instead. Note that build_from_scratch.sh
# does NOT pass this through — compose does, via env_file.
# TRAEFIK_DNS_API_TOKEN=
#
# Issuance troubleshooting. Point the resolvers at the zone's authoritative
# nameservers if a DNSSEC-signed zone makes lego's pre-check read a cached negative:
# TRAEFIK_DNS_RESOLVERS=sid.ns.cloudflare.com:53,elle.ns.cloudflare.com:53
# TRAEFIK_DNS_DISABLE_PROPAGATION_CHECK=true
# TRAEFIK_DNS_DELAY_BEFORE_CHECK=30s

# --- Seed overrides (optional; defaults live in build_from_scratch.sh) ---
# HOMELAB_INSTANCE_NAME=Homelab
# HOMELAB_BASE_DOMAIN=homelab.example.com
# HOMELAB_OIDC_ISSUER=https://id.example.com
# HOMELAB_OIDC_CLIENT_ID=
# HOMELAB_ORCHESTRATOR=docker_engine
# HOMELAB_GATEWAY=traefik

# --- Phoenix endpoint (public URL used to build absolute links/redirects) ---
# Defaults to HOMELAB_BASE_DOMAIN / https / 443 in build_from_scratch.sh.
# PHX_HOST=homelab.example.com
# PHX_SCHEME=https
# PHX_PORT=443

# --- Secrets (optional overrides) ---
# If unset, a stable SECRET_KEY_BASE is generated once and persisted to the
# homelab-iab-secrets volume. Set it explicitly to manage it as a Docker/Swarm secret.
# Generate with: mix phx.gen.secret  (or: openssl rand -base64 48)
# SECRET_KEY_BASE=

# --- Storage and backups ---
# Two host directories, bind-mounted at the SAME path inside the container.
#
# HOMELAB_MANAGED_ROOT is where adopted application data lives. The daemon reads it
# as a host path when it creates managed volumes and the app reads it directly to
# archive it, so the two must agree — which is why the mount is not remapped.
#
# HOMELAB_BACKUP_ROOT is where archives are written. Without it, an archive would
# land inside the container and the next restart would erase it, so the app refuses
# to write one rather than pretend a backup exists. It needs room for what you keep:
# archives are compressed, but an already-compressed library (FLAC, MP4) will not
# shrink, so budget close to the size of the data itself per retained copy.
#
# Losing the recovery key in the homelab-iab-secrets volume makes every archive in
# here unreadable. Store it off this machine — Settings -> Backups shows it once.
# HOMELAB_MANAGED_ROOT=/srv/homelab/managed
# HOMELAB_BACKUP_ROOT=/srv/homelab/backups

# --- Image (optional) ---
# Which published GHCR tag docker-compose.prod.yml runs. Defaults to latest;
# pin a release for reproducible deploys, e.g. v1.2.3.
# HOMELAB_IMAGE_TAG=latest

# --- Resource limits (optional) ---
# HOMELAB_MEMORY_LIMIT=1g
# HOMELAB_CPU_LIMIT=2
